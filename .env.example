# Port the HTTP server listens on.
PORT=3000

# Postgres connection string: protocol, user, host, port, database.
# It points at PgBouncer (21111), not Postgres (21110): the app's runtime
# connections share PgBouncer's pool. Migrations and seed go to Postgres
# directly through MIGRATIONS_DB_URL, which isn't read by the app.
# The password segment here is never actually used — the app reads the
# real password from secrets/db_password at connection time, so any
# value after the colon is fine.
DB_URL=postgres://app_user:changeme@localhost:21111/shop

# RabbitMQ (AMQP port 21113, not the UI's 21114). A placeholder: the real URL comes
# from the secrets store through scripts/with-secrets.sh, or from an exported
# variable with SKIP_VAULT=1. The environment wins over this file.
RABBITMQ_URL=amqp://USER:PASSWORD@127.0.0.1:21113

# Redis (HW#23): two instances, never one. The cache (127.0.0.1:21115) and the queue
# (127.0.0.1:21116, BullMQ jobs and sessions). The dev instances have no password, so
# these work as they are; the secrets store, or exported variables with SKIP_VAULT=1,
# win over this file.
REDIS_CACHE_URL=redis://127.0.0.1:21115
REDIS_QUEUE_URL=redis://127.0.0.1:21116
