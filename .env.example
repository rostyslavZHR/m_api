# Port the HTTP server listens on.
PORT=3000

# Postgres connection string: protocol, user, host, port, database.
# It points at PgBouncer (21111), not Postgres (21110): the app's runtime
# connections share PgBouncer's pool. Migrations and seed go to Postgres
# directly through MIGRATIONS_DB_URL, which isn't read by the app.
# The password segment here is never actually used — the app reads the
# real password from secrets/db_password at connection time, so any
# value after the colon is fine.
DB_URL=postgres://app_user:changeme@localhost:21111/shop
